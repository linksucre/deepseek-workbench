{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deepseek-workbench:v1",
  "$defs": {
    "TaskId": {
      "type": "string",
      "format": "uuid"
    },
    "Status": {
      "enum": [
        "draft",
        "ready",
        "active",
        "review",
        "accepted",
        "paused",
        "blocked",
        "cancelled"
      ]
    },
    "Criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "id",
        "description"
      ]
    },
    "ExecutionChoice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "development",
            "design",
            "writing",
            "research",
            "documents"
          ]
        },
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "direct",
              "direction-review",
              "verify-first",
              "reuse"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "skillIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "source": {
          "enum": [
            "agent",
            "user"
          ]
        }
      },
      "required": [
        "domain",
        "methods",
        "reason",
        "skillIds",
        "source"
      ]
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "file",
            "url",
            "session-event"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "locator",
        "observedAt"
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rootSessionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "childSessionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "intentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "rootSessionId",
        "childSessionIds",
        "intentId",
        "startedAt",
        "endedAt"
      ]
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "file",
            "git",
            "external-link"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "versionKind": {
          "enum": [
            "sha256",
            "git-commit",
            "unverified"
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "id",
        "kind",
        "locator",
        "versionKind",
        "version",
        "source"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criterionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "machine",
            "user",
            "model-claim",
            "unverified"
          ]
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "criterionId",
        "kind",
        "outcome",
        "source",
        "observedAt",
        "summary"
      ]
    },
    "Submission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "briefRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "criteriaSnapshot": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        }
      },
      "required": [
        "id",
        "runId",
        "submittedAt",
        "briefRevision",
        "artifactIds",
        "evidence",
        "criteriaSnapshot"
      ]
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verdict": {
          "enum": [
            "accept",
            "return"
          ]
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "submissionId",
        "verdict",
        "decidedAt",
        "actorId",
        "reason"
      ]
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/TaskId"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionChoice"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeRunId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "currentSubmissionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "revision",
        "status",
        "title",
        "goal",
        "materials",
        "deliverables",
        "criteria",
        "choice",
        "activeRunId",
        "currentSubmissionId",
        "createdAt",
        "updatedAt"
      ]
    },
    "TaskDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "$ref": "#/$defs/Task"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Run"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "submissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Submission"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Decision"
          }
        }
      },
      "required": [
        "task",
        "runs",
        "artifacts",
        "submissions",
        "decisions"
      ]
    },
    "TaskPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "UsageBucket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "uncachedInput": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheRead": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheWrite": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "model",
        "uncachedInput",
        "cacheRead",
        "cacheWrite",
        "output"
      ]
    },
    "UsageSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "coverageNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "buckets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UsageBucket"
          }
        },
        "estimatedCost": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "decimalAmount": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?$"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "rateDate": {
                  "type": "string",
                  "format": "date"
                }
              },
              "required": [
                "decimalAmount",
                "currency",
                "rateDate"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "taskId",
        "completeness",
        "coverageNotes",
        "buckets",
        "estimatedCost"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID",
            "FORBIDDEN",
            "NOT_FOUND",
            "REVISION_CONFLICT",
            "INVALID_TRANSITION",
            "ARTIFACT_DRIFT",
            "RECONCILIATION_REQUIRED",
            "UNSUPPORTED",
            "HOST_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "CreateTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        }
      },
      "required": [
        "workspaceId",
        "requestId",
        "title",
        "goal",
        "materials",
        "deliverables",
        "criteria"
      ]
    },
    "UpdateBrief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        }
      },
      "required": [
        "taskId",
        "requestId",
        "expectedRevision",
        "title",
        "goal",
        "materials",
        "deliverables",
        "criteria"
      ]
    },
    "ChooseExecution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "choice": {
          "$ref": "#/$defs/ExecutionChoice"
        }
      },
      "required": [
        "taskId",
        "requestId",
        "expectedRevision",
        "choice"
      ]
    },
    "TaskMutation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "taskId",
        "requestId",
        "expectedRevision"
      ]
    },
    "GetTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "taskId"
      ]
    },
    "ListTasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "workspaceId",
        "cursor",
        "limit"
      ]
    },
    "ReconcileRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "action": {
          "enum": [
            "attach",
            "discard-intent"
          ]
        },
        "rootSessionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "taskId",
        "requestId",
        "expectedRevision",
        "action",
        "rootSessionId"
      ]
    },
    "SubmitTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "taskId",
        "requestId",
        "expectedRevision",
        "artifactIds",
        "evidenceRefs"
      ]
    },
    "DecideTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verdict": {
          "enum": [
            "accept",
            "return"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "taskId",
        "requestId",
        "expectedRevision",
        "submissionId",
        "verdict",
        "reason"
      ]
    },
    "AgentSuggest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "direct",
              "direction-review",
              "verify-first",
              "reuse"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "domain": {
          "enum": [
            "development",
            "design",
            "writing",
            "research",
            "documents"
          ]
        },
        "skillIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "methods",
        "reason",
        "domain",
        "skillIds"
      ]
    },
    "AgentSubmit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "artifactIds",
        "evidenceRefs"
      ]
    },
    "AgentAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
